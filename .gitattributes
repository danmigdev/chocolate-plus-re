# Shell scripts and git hooks must keep LF line endings (core.autocrlf would break the shebang)
*.sh            text eol=lf
*.command       text eol=lf
tools/hooks/*   text eol=lf
# Windows batch files
*.bat           text eol=crlf
# Keep hashed firmware-extension sources identical in Windows and WSL.
firmware/patch_src/sysex_gap.*       text eol=lf
firmware/patch_src/sysex_gap_glue.S  text eol=lf
firmware/patch_src/test_sysex_gap.c  text eol=lf
